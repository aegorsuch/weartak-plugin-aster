+#[cfg(target_os = "android")]
+static ANDROID_CONTROL_DIRECTORY: std::sync::OnceLock<LocalPathIdentity> = std::sync::OnceLock::new();
+
+/// Pins an existing owner-only application-private control directory for this process.
+/// Every node and local zeroization client must initialize the same directory.
+#[cfg(target_os = "android")]
+pub fn initialize_android_control_directory(directory: &Path) -> Result<(), NodeError> {
+    use std::os::unix::ffi::OsStrExt as _;
+
+    if !directory.is_absolute() {
+        return Err(NodeError::Configuration(
+            "Android control directory must be absolute".into(),
+        ));
+    }
+    let validated = local_zeroization_control_directory_at(directory, false)?;
+    // Reject aliases through symlink ancestors as well as a symlink at the leaf.
+    if validated.canonical_path != directory {
+        return Err(NodeError::Configuration(
+            "Android control directory must be canonical".into(),
+        ));
+    }
+    if local_zeroization_socket_path(directory, u64::MAX, u64::MAX)
+        .as_os_str()
+        .as_bytes()
+        .len()
+        >= 108
+    {
+        return Err(NodeError::Configuration(
+            "Android control directory exceeds the Unix socket pathname limit".into(),
+        ));
+    }
+    let pinned = ANDROID_CONTROL_DIRECTORY.get_or_init(|| validated);
+    let current = local_zeroization_control_directory_at(directory, false)?;
+    if current.canonical_path != pinned.canonical_path
+        || current.device != pinned.device
+        || current.inode != pinned.inode
+    {
+        return Err(NodeError::Configuration(
+            "Android control directory already pinned to another identity".into(),
+        ));
+    }
+    Ok(())
 }
 
